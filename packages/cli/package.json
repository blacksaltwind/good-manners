{
  "name": "good-manners",
  "version": "0.0.1",
  "description": "Human-first UX guardrails for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "good-manners": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @good-manners/skill build && node scripts/build-bundles.mjs && node scripts/copy-skill.mjs",
    "dev": "tsx src/index.ts",
    "prepack": "pnpm run build",
    "test:installer": "pnpm run build && node scripts/test-installer.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blacksaltwind/good-manners.git"
  },
  "homepage": "https://github.com/blacksaltwind/good-manners#readme",
  "bugs": {
    "url": "https://github.com/blacksaltwind/good-manners/issues"
  },
  "keywords": [
    "ux",
    "accessibility",
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "hci",
    "lint",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  }
}
